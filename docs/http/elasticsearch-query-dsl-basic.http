# Elasticsearch 7.17.23 Query DSL 基础查询练习
# 使用方式：在 IntelliJ IDEA 中从上到下逐条点击请求左侧运行按钮。
# 安全边界：所有写操作只针对 mall_product_query_v1，不使用通配符删除索引。

@esHost = http://localhost:9200
@indexName = mall_product_query_v1

### 1. 查看节点和版本信息
# 预期：HTTP 200，version.number 为 7.17.23。
# @name nodeInfo
GET {{esHost}}/
Accept: application/json

###

### 2. 清理可能残留的同名练习索引
# ignore_unavailable=true 允许索引不存在，便于重复从头实验。
# @name cleanupBeforeStart
DELETE {{esHost}}/{{indexName}}?ignore_unavailable=true
Accept: application/json

###

### 3. 创建 Query DSL 练习索引
# productName 和 description 使用 text，用于全文搜索。
# productName.keyword 用于精确匹配、排序或聚合。
# status、brandName、tags 使用 keyword，用于过滤。
# @name createQueryIndex
PUT {{esHost}}/{{indexName}}
Content-Type: application/json
Accept: application/json

{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "productId": {
        "type": "long"
      },
      "productName": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "productCode": {
        "type": "keyword"
      },
      "categoryId": {
        "type": "long"
      },
      "categoryName": {
        "type": "keyword"
      },
      "brandName": {
        "type": "keyword"
      },
      "price": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "sales": {
        "type": "integer"
      },
      "stock": {
        "type": "integer"
      },
      "status": {
        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      "description": {
        "type": "text"
      },
      "createdAt": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      }
    }
  }
}

###

### 4. 批量写入商品搜索练习数据
# Content-Type 必须为 application/x-ndjson。
# 请求体引用独立 ndjson 文件，确保 Bulk API 最后一行以换行符结束。
# 预期：HTTP 200，errors=false。
# @name bulkInitQueryProducts
POST {{esHost}}/_bulk?refresh=wait_for
Content-Type: application/x-ndjson
Accept: application/json

< ./elasticsearch-query-dsl-products.ndjson

###

### 5. 查看索引 Mapping
# 重点观察 productName 是 text，并带 productName.keyword 子字段。
# @name getMapping
GET {{esHost}}/{{indexName}}/_mapping
Accept: application/json

###

### 6. match_all 查询全部文档
# 预期：能看到全部练习商品。
# @name matchAll
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "query": {
    "match_all": {}
  }
}

###

### 7. _source 字段过滤：只返回列表页需要的字段
# 生产建议：搜索列表页不要返回过大的详情字段。
# @name sourceFiltering
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "brandName",
    "price",
    "sales"
  ],
  "query": {
    "match_all": {}
  }
}

###

### 8. from/size 普通分页
# 预期：从第 0 条开始返回 3 条。
# @name pageByFromSize
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "from": 0,
  "size": 3,
  "query": {
    "match_all": {}
  }
}

###

### 9. sort 排序：按价格升序，再按创建时间倒序
# 注意：排序字段应使用 keyword、数值、日期等非 text 字段。
# @name sortByPriceAndCreatedAt
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "price",
    "createdAt"
  ],
  "sort": [
    {
      "price": "asc"
    },
    {
      "createdAt": "desc"
    }
  ],
  "query": {
    "match_all": {}
  }
}

###

### 10. term 精确查询：查询上架商品
# status 是 keyword，适合 term 精确查询。
# @name termStatusOnSale
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "query": {
    "term": {
      "status": "ON_SALE"
    }
  }
}

###

### 11. terms 多值精确查询：查询多个分类
# 类似 SQL 中的 WHERE categoryId IN (20, 30)。
# @name termsCategory
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "query": {
    "terms": {
      "categoryId": [
        20,
        30
      ]
    }
  }
}

###

### 12. term 精确查询 keyword 子字段：完整商品名匹配
# productName 是 text，productName.keyword 是 keyword。
# @name termProductNameKeyword
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "query": {
    "term": {
      "productName.keyword": "三模机械键盘"
    }
  }
}

###

### 13. match 全文查询：按商品名搜索
# match 会对查询文本进行分析，适合 text 字段。
# @name matchProductName
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "description"
  ],
  "query": {
    "match": {
      "productName": "机械键盘"
    }
  }
}

###

### 14. multi_match 多字段全文查询
# productName^3 表示商品名称字段权重更高。
# @name multiMatchProduct
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "brandName",
    "description"
  ],
  "query": {
    "multi_match": {
      "query": "无线 外设",
      "fields": [
        "productName^3",
        "brandName",
        "description"
      ]
    }
  }
}

###

### 15. range 范围查询：价格区间
# 预期：查询价格在 100 到 500 之间的商品。
# @name rangePrice
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "price"
  ],
  "query": {
    "range": {
      "price": {
        "gte": 100,
        "lte": 500
      }
    }
  }
}

###

### 16. range 范围查询：创建时间区间
# 预期：查询 2026-06-01 到 2026-06-30 创建的商品。
# @name rangeCreatedAt
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "createdAt"
  ],
  "query": {
    "range": {
      "createdAt": {
        "gte": "2026-06-01T00:00:00+08:00",
        "lte": "2026-06-30T23:59:59+08:00"
      }
    }
  }
}

###

### 17. bool 查询：关键词 + 上架状态 + 价格过滤
# must 参与评分，filter 不参与评分，更适合状态、分类、价格等结构化条件。
# @name boolMustAndFilter
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "status",
    "price",
    "tags"
  ],
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "productName": "键盘"
          }
        }
      ],
      "filter": [
        {
          "term": {
            "status": "ON_SALE"
          }
        },
        {
          "range": {
            "price": {
              "gte": 100,
              "lte": 500
            }
          }
        }
      ]
    }
  }
}

###

### 18. bool 查询：排除清仓商品
# must_not 常用于排除下架、清仓、黑名单等数据。
# @name boolMustNot
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "tags"
  ],
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "status": "ON_SALE"
          }
        }
      ],
      "must_not": [
        {
          "term": {
            "tags": "清仓"
          }
        }
      ]
    }
  }
}

###

### 19. should 查询：商品名或描述命中“键盘”
# minimum_should_match=1 表示 should 条件至少命中一个。
# @name boolShouldMinimum
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "_source": [
    "productId",
    "productName",
    "description"
  ],
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "status": "ON_SALE"
          }
        }
      ],
      "should": [
        {
          "match": {
            "productName": "键盘"
          }
        },
        {
          "match": {
            "description": "键盘"
          }
        }
      ],
      "minimum_should_match": 1
    }
  }
}

###

### 20. 综合商品搜索：关键词、分类、价格、排序、分页
# 这是最接近真实商城搜索接口的一条练习查询。
# @name productSearchLikeApi
GET {{esHost}}/{{indexName}}/_search
Content-Type: application/json
Accept: application/json

{
  "from": 0,
  "size": 10,
  "_source": [
    "productId",
    "productName",
    "categoryName",
    "brandName",
    "price",
    "sales"
  ],
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "无线 键盘",
            "fields": [
              "productName^3",
              "brandName^2",
              "description"
            ]
          }
        }
      ],
      "filter": [
        {
          "term": {
            "status": "ON_SALE"
          }
        },
        {
          "term": {
            "categoryId": 20
          }
        },
        {
          "range": {
            "price": {
              "gte": 100,
              "lte": 800
            }
          }
        }
      ]
    }
  },
  "sort": [
    {
      "_score": "desc"
    },
    {
      "sales": "desc"
    },
    {
      "price": "asc"
    }
  ]
}

###

### 21. 删除本阶段练习索引
# 如果你还想在 Kibana Discover 中查看数据，先不要执行本请求。
# @name cleanupAfterQueryDslPractice
DELETE {{esHost}}/{{indexName}}?ignore_unavailable=true
Accept: application/json
